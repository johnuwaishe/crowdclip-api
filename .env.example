DATABASE_URL=

# Instagram Login credentials and callback configuration:
# Meta App Dashboard > Instagram > API setup with Instagram login.
# Used for OAuth authorization and token exchange.
# INSTAGRAM_APP_SECRET also validates X-Hub-Signature-256 on webhook POSTs.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v24.0
INSTAGRAM_API_TIMEOUT_MS=10000
INSTAGRAM_OAUTH_STATE_SECRET=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Custom token chosen by CrowdClip for Meta's initial webhook GET challenge.
# This is not either app secret and is not used for webhook POST signatures.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# CrowdClip session and public fan-upload token signing.
CROWDCLIP_SESSION_SECRET=
ORIGINAL_FILE_UPLOAD_TOKEN_SECRET=

STORY_MENTION_WORKER_ENABLED=true
STORY_MENTION_WORKER_POLL_INTERVAL_MS=2000
STORY_MENTION_WORKER_BATCH_SIZE=10
STORY_MENTION_WORKER_STALE_AFTER_MS=300000
STORY_MENTION_WORKER_MAX_ATTEMPTS=3
STORY_MENTION_WORKER_RETRY_DELAY_MS=60000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MEDIA_STORAGE_BUCKET=clip-media
MEDIA_DOWNLOAD_WORKER_ENABLED=true
MEDIA_DOWNLOAD_WORKER_POLL_INTERVAL_MS=5000
MEDIA_DOWNLOAD_WORKER_BATCH_SIZE=1
MEDIA_DOWNLOAD_WORKER_STALE_AFTER_MS=600000
MEDIA_DOWNLOAD_WORKER_MAX_ATTEMPTS=3
MEDIA_DOWNLOAD_WORKER_RETRY_DELAY_MS=60000
MEDIA_DOWNLOAD_MAX_BYTES=52428800
MEDIA_DOWNLOAD_TIMEOUT_MS=30000
MEDIA_UPLOAD_TIMEOUT_MS=30000
MEDIA_SIGNED_URL_TIMEOUT_MS=5000
MEDIA_PREVIEW_URL_TTL_SECONDS=300

AUDIO_ANALYSIS_WORKER_ENABLED=true
AUDIO_ANALYSIS_WORKER_POLL_INTERVAL_MS=5000
AUDIO_ANALYSIS_WORKER_BATCH_SIZE=1
AUDIO_ANALYSIS_WORKER_STALE_AFTER_MS=600000
AUDIO_ANALYSIS_WORKER_MAX_ATTEMPTS=3
AUDIO_ANALYSIS_WORKER_RETRY_DELAY_MS=60000
AUDIO_ANALYSIS_PROCESS_TIMEOUT_MS=300000
AUDIO_ANALYSIS_SIGNED_URL_TTL_SECONDS=900
AUDIO_ANALYSIS_DIRECTORY=audio-analysis
AUDIO_ANALYSIS_PYTHON_PATH=audio-analysis/.venv/bin/python
AUDIO_REFERENCE_MAX_BYTES=104857600
AUDIO_REFERENCE_STORAGE_BUCKET=audio-references
